# Server Port (Cloud platforms like Render/Railway inject this automatically)
PORT=5000

# Option 1: Cloud Database Connection String (Railway, Aiven, Render)
# DATABASE_URL=mysql://user:password@host:3306/chat_app

# Option 2: Individual Database Connection Fields
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chat_app

# Enable SSL for Cloud MySQL (e.g. Aiven, TiDB, Railway)
DB_SSL=false

# JWT Secret for User Authentication
JWT_SECRET=pulsechat_production_secret_key_change_me
